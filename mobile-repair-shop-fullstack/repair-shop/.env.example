# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/repair_shop?schema=public"

# Temporary bootstrap values for `npm run staff:create-owner` only.
# Set these privately in .env, create the owner account, then remove both values.
BOOTSTRAP_OWNER_EMAIL=""
BOOTSTRAP_OWNER_NAME="Shop Owner"
BOOTSTRAP_OWNER_PASSWORD=""

# Optional AI translation configuration. Never expose these as NEXT_PUBLIC_* variables.
OPENAI_API_KEY=""
TRANSLATION_MODEL="gpt-4.1-mini"
OPENAI_BASE_URL="https://api.openai.com/v1/chat/completions"
NEXT_PUBLIC_SITE_URL="https://your-domain.example"
